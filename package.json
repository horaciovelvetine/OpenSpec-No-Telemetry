{
	"name": "@fission-ai/openspec",
	"version": "1.14.1",
	"private": true,
	"description": "Private, no-telemetry OpenSpec runtime bundled for offline consumers",
	"keywords": [
		"openspec",
		"specs",
		"cli",
		"ai",
		"development"
	],
	"homepage": "https://github.com/horaciovelvetine/OpenSpec-No-Telemetry",
	"repository": {
		"type": "git",
		"url": "https://github.com/horaciovelvetine/OpenSpec-No-Telemetry.git"
	},
	"license": "MIT",
	"author": "OpenSpec Contributors",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"default": "./dist/cli/index.js"
		},
		"./cli-kit": {
			"types": "./dist/cli-kit.d.ts",
			"default": "./dist/cli-kit.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"openspec": "./bin/openspec.js"
	},
	"files": [
		"dist",
		"bin",
		"schemas",
		"!dist/**/*.test.js",
		"!dist/**/__tests__",
		"!dist/**/*.map"
	],
	"scripts": {
		"lint": "eslint src/",
		"build": "node build.js",
		"regen:parity-hashes": "node scripts/regen-parity-hashes.mjs",
		"dev": "tsc --watch",
		"dev:cli": "pnpm build && node bin/openspec.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@vitest/ui": "^4.1.11",
		"eslint": "^10.5.0",
		"smol-toml": "^1.7.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@inquirer/core": "^12.0.0",
		"@inquirer/prompts": "^8.5.2",
		"chalk": "^5.6.2",
		"commander": "^14.0.0",
		"cross-spawn": "7.0.6",
		"diff": "^9.0.0",
		"fast-glob": "^3.3.3",
		"ora": "^9.4.1",
		"yaml": "^2.8.3",
		"zod": "^4.4.3"
	}
}
